{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tombaugh-docs",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "docs"],
      "port": 5500
    },
    {
      "name": "tombaugh-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
